# API server (keep real values in a local .env file; never commit them)
GEMINI_API_KEY=
MONGODB_URI=
SESSION_SECRET=
GITLAB_TOKEN=
GITLAB_USERNAME=

# Local API server
PORT=8080
NODE_ENV=development

# Frontend
# Leave empty for local Vite proxying. Set this to the deployed API URL in production.
VITE_API_URL=
# Optional local override if the API runs on a different port.
API_PROXY_TARGET=http://127.0.0.1:8080